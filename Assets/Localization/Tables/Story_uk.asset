  m_TableData:
  - m_Id: 10316931072
    m_Localized: "\u041A\u043E\u0436\u043D\u0430 \u0441\u043F\u0440\u043E\u0431\u0430
      \u0434\u043E\u0441\u043B\u0456\u0434\u0438\u0442\u0438 \u0430\u043D\u043E\u043C\u0430\u043B\u0456\u044E
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044F \u043D\u0435\u0432\u0434\u0430\u0447\u0435\u044E.
      \u041D\u0430\u0443\u043A\u043E\u0432\u0430 \u0435\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0456\u044F,
      \u044F\u043A\u0430 \u0443\u0432\u0456\u043C\u043A\u043D\u0443\u043B\u0430 \u0434\u0440\u0435\u043D\u0430\u0436\u043D\u0456
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457, \u0442\u0430\u043A \u0456 \u043D\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F... \u0456
      \u0446\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u0430
      \u043D\u043E\u0432\u0438\u043D\u0430.\n\n\u0429\u043E\u0441\u044C \u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u043E\u0441\u044F
      \u0433\u043B\u0438\u0431\u043E\u043A\u043E \u043F\u0456\u0434 \u0437\u0435\u043C\u043B\u0435\u044E,
      \u0456 \u0439\u043E\u0433\u043E \u0432\u043F\u043B\u0438\u0432 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E
      \u0440\u0443\u0439\u043D\u0443\u0454 \u043D\u0430\u0448\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0443.\n\n\u041C\u0438
      \u0432\u0432\u0430\u0436\u0430\u0454\u043C\u043E, \u0449\u043E, \u0432\u0438\u043C\u043A\u043D\u0443\u0432\u0448\u0438
      \u0441\u0442\u0430\u043D\u0446\u0456\u0457 \u0442\u0430 \u0437\u043D\u043E\u0432\u0443
      \u0437\u0430\u0442\u043E\u043F\u0438\u0432\u0448\u0438 \u0431\u0430\u0441\u0435\u0439\u043D,
      \u0446\u044F \u0434\u0430\u0432\u043D\u044F \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C,
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0437\u043C\u043E\u0436\u0435
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0432 \u0437\u0430\u0431\u0443\u0442\u0442\u044F.\n\n\u0422\u0438
      \u043D\u0430\u0448\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u044F \u043D\u0430\u0434\u0456\u044F.\n\n\u0421\u0456\u0434\u0430\u0439
      \u0443 \u0446\u044E \u0441\u0442\u0430\u0440\u0443 \u0441\u043B\u0443\u0436\u0431\u043E\u0432\u0443
      \u043F\u043E\u0432\u0456\u0442\u0440\u044F\u043D\u0443 \u043A\u0443\u043B\u044E,
      \u0434\u0456\u0441\u0442\u0430\u043D\u044C\u0441\u044F \u0434\u043E \u0432\u0441\u0456\u0445
      \u0441\u0442\u0430\u043D\u0446\u0456\u0439 \u0456 \u0432\u0438\u043C\u043A\u043D\u0438
      \u0457\u0445.\n\n\u0417\u0430\u0432\u0436\u0434\u0438 \u0442\u0440\u0438\u043C\u0430\u0439
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0443 \u0432\u0438\u0441\u043E\u0442\u0443...
      \u043D\u0435 \u0437\u0432\u043E\u0434\u044C \u043E\u0447\u0435\u0439 \u0456\u0437
      \u0446\u0438\u0445 \u0456\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u0456\u0432.\n\n\u0423\u0434\u0430\u0447\u0456."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
