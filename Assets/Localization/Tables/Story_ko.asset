  m_TableData:
  - m_Id: 10316931072
    m_Localized: "\uC6B0\uC8FC\uC801 \uB300\uC7AC\uC559\uC774 \uC9C0\uAD6C\uB97C
      \uD729\uC4F8\uC5B4 \uD669\uB7C9\uD558\uACE0 \uC0AC\uB78C\uC774 \uC0B4 \uC218
      \uC5C6\uB294 \uD3D0\uD5C8\uB85C \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uD558\uB298\uC740
      \uAD11\uD48D\uC774 \uBAB0\uC544\uCE58\uB294 \uC74C\uC0B0\uD55C \uC7A5\uB9C9\uC73C\uB85C
      \uBCC0\uD588\uACE0, \uB300\uC591\uC740 \uAC78\uCB49\uD55C \uC9C4\uD64D\uBE5B
      \uBB3C\uC9C8\uB85C \uB4A4\uB36E\uC600\uC2B5\uB2C8\uB2E4.\r\n\n\uC774 \uC7AC\uC559\uC744
      \uC774\uD574\uD558\uB824\uB294 \uD544\uC0AC\uC758 \uC2DC\uB3C4\uB85C \uACFC\uD559
      \uD0D0\uC0AC\uB300\uAC00 \uADF8 \uADFC\uC6D0\uC774 \uB418\uB294 \uBD84\uC9C0\uB97C
      \uCC3E\uC544\uB0C8\uACE0, \uC561\uCCB4\uB97C \uD37C\uB0B4\uC5B4 \uD574\uC800\uC758
      \uBE44\uBC00\uC744 \uBC1D\uD600\uB0B4\uAE30 \uC704\uD574 \uBC30\uC218 \uAE30\uC9C0\uB4E4\uC744
      \uAC74\uC124\uD588\uC2B5\uB2C8\uB2E4.\r\n\n\uD558\uC9C0\uB9CC \uC778\uB958\uC758
      \uAC1C\uC785\uC740 \uC601\uC6D0\uD788 \uBB3B\uD600 \uC788\uC5B4\uC57C \uD588\uC744
      \uBB34\uC5B8\uAC00\uB97C \uAE68\uC6E0\uACE0, \uC0C1\uD669\uC740 \uC21C\uC2DD\uAC04\uC5D0
      \uD30C\uAD6D\uC73C\uB85C \uCE58\uB2EC\uC558\uC2B5\uB2C8\uB2E4. \uC774\uC81C
      \uC720\uC77C\uD55C \uD76C\uB9DD\uC740 \uD669\uB7C9\uD55C \uD611\uACE1\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\u6050\u6016\uAC00 \uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294
      \uAC83\uC774 \uB418\uAE30 \uC804\uC5D0 \uBAA8\uB4E0 \uBC30\uC218 \uAE30\uC9C0\uB97C
      \uC815\uC9C0\uC2DC\uD0A4\uB294 \uAC83\uBFD0\uC785\uB2C8\uB2E4.\n\n\uC774 \uC77C\uC744
      \uD558\uB824\uBA74 \uC624\uB798\uB41C \uC11C\uBE44\uC2A4\uC6A9 \uC5F4\uAE30\uAD6C\uB97C
      \uD0C0\uACE0 \uBE44\uD589\uD574\uC57C \uD569\uB2C8\uB2E4... \uC774\uAC83\uC774
      \uB2F9\uC2E0\uC758 \uC784\uBB34\uC785\uB2C8\uB2E4. \n\n\uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
