  m_TableData:
  - m_Id: 10316931072
    m_Localized: "\uC774 \uBCC0\uCE59 \uD604\uC0C1\uC744 \uC5F0\uAD6C\uD558\uB824\uB294
      \uBAA8\uB4E0 \uC2DC\uB3C4\uB294 \uC2E4\uD328\uB85C \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.
      \uBC30\uC218 \uC2DC\uC124\uC744 \uAC00\uB3D9\uD55C \uACFC\uD559 \uD0D0\uC0AC\uB300\uB294
      \uB2E4\uC2DC \uB3CC\uC544\uC624\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4... \uADF8\uB9AC\uACE0
      \uADF8\uAC83\uC740 \uCD5C\uC545\uC758 \uC18C\uC2DD\uC870\uCC28 \uC544\uB2D9\uB2C8\uB2E4.\n\n\uBB34\uC5B8\uAC00\uAC00
      \uC9C0\uAD6C \uAE4A\uC740 \uACF3\uC5D0\uC11C \uAE68\uC5B4\uB0AC\uACE0, \uADF8
      \uC601\uD5A5\uC740 \uC11C\uC11C\uD788 \uC6B0\uB9AC\uC758 \uD589\uC131\uC744
      \uC7A0\uC2DD\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC6B0\uB9AC\uB294 \uBC30\uC218
      \uC2DC\uC124\uC744 \uB044\uACE0 \uBD84\uC9C0\uB97C \uB2E4\uC2DC \uCC44\uC6B0\uBA74,
      \uC774 \uACE0\uB300\uC758 \uC874\uC7AC\uAC00 \uB2E4\uC2DC \uB9DD\uAC01 \uC18D\uC73C\uB85C
      \uB3CC\uC544\uAC08 \uC218 \uC788\uC744 \uAC83\uC774\uB77C \uBBFF\uC2B5\uB2C8\uB2E4.\n\n\uB2F9\uC2E0\uC774
      \uC6B0\uB9AC\uC758 \uB9C8\uC9C0\uB9C9 \uD76C\uB9DD\uC785\uB2C8\uB2E4.\n\n\uC800
      \uC624\uB798\uB41C \uC791\uC5C5\uC6A9 \uC5F4\uAE30\uAD6C\uC5D0 \uC62C\uB77C\uD0C0
      \uBAA8\uB4E0 \uC2DC\uC124\uB85C \uC774\uB3D9\uD574 \uC791\uB3D9\uC744 \uBA48\uCD94\uC2ED\uC2DC\uC624.\n\n\uD56D\uC0C1
      \uC548\uC804 \uACE0\uB3C4\uB97C \uC720\uC9C0\uD558\uC138\uC694... \uC800 \uD45C\uC2DC\uB4F1\uC744
      \uC798 \uC0B4\uD53C\uC138\uC694.\n\n\uD589\uC6B4\uC744 \uBE55\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
