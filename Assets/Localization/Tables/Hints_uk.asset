  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "\u0427\u0435\u0440\u0432\u043E\u043D\u0438\u0439: \u041F\u0456\u0434\u0439\u043E\u043C\n\u0411\u0456\u043B\u0438\u0439:
      \u0423\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u0441\u043E\u0442\u0443\n\u0421\u0438\u043D\u0456\u0439:
      \u0417\u043D\u0438\u0436\u0435\u043D\u043D\u044F\n(\u0446\u0456\u043B\u044C\u043E\u0432\u0430/\u043F\u043E\u0442\u043E\u0447\u043D\u0430
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "\u041F\u0456\u0434\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439 \u0434\u0456\u0430\u043F\u0430\u0437\u043E\u043D
      \u0432\u0438\u0441\u043E\u0442\u0438\n(\u041D\u0430\u043C\u0430\u0433\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E\u0431 \u0456\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u0438
      \u0437\u0430\u043B\u0438\u0448\u0430\u043B\u0438\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u0438\u043C\u0438)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "\u041F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E \u0432\u043C\u0456\u0454\u0442\u0435 \u043A\u0435\u0440\u0443\u0432\u0430\u0442\u0438
      \u0432\u0438\u0441\u043E\u0442\u043E\u044E \u043F\u0435\u0440\u0435\u0434 \u0432\u0438\u043B\u044C\u043E\u0442\u043E\u043C.\r\n\u0427\u0435\u0440\u0432\u043E\u043D\u0456
      \u0456\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u0438 \u0442\u0430 \u0441\u0438\u0433\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u044F
      \u0432\u043A\u0430\u0437\u0443\u044E\u0442\u044C \u043D\u0430 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0443
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u043E\u043B\u044C\u043E\u0442\u0443.\r\n\u041F\u0430\u043C'\u044F\u0442\u0430\u0439\u0442\u0435,
      \u0449\u043E \u0443 \u0432\u0430\u0441 \u0454 \u043A\u0430\u0440\u0442\u0430
      (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0433\u0430\u0439\u043A\u043E\u0432\u0438\u0439 \u043A\u043B\u044E\u0447 \u0434\u043B\u044F
      \u0440\u0435\u043C\u043E\u043D\u0442\u0443 (\u0430\u0431\u043E \u0443\u0434\u0430\u0440\u0443)"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "\u041C\u0430\u043B\u043E \u043F\u0430\u043B\u044C\u043D\u043E\u0433\u043E?
      \u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u0442\u0443\u0442 :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: "\u041B\u0435\u0442\u0456\u0442\u0438 \u043D\u0430 \u041F\u0456\u0432\u043D\u0456\u0447"
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: "\u041B\u0435\u0442\u0456\u0442\u0438 \u043D\u0430 \u0421\u0445\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: "\u041B\u0435\u0442\u0456\u0442\u0438 \u043D\u0430 \u041F\u0456\u0432\u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: "\u041B\u0435\u0442\u0456\u0442\u0438 \u043D\u0430 \u0417\u0430\u0445\u0456\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "\u0412\u0430\u0448\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0430
      \u043C\u0435\u0442\u0430.\r\n\r\n\u0417\u0430\u043F\u0440\u0430\u0432\u043D\u0430
      \u0441\u0442\u0430\u043D\u0446\u0456\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "\u0421\u0442\u0430\u043D\u0446\u0456\u044E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E
