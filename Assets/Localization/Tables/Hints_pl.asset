      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "Utrzymuj bezpieczny zakres wysoko\u015Bci\n(Staraj si\u0119 utrzymywa\u0107
      kontrolki na zielono)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Naci\u015Bnij, aby uda\u0107 si\u0119 na Po\u0142udnie\n(Sprawd\u017A
