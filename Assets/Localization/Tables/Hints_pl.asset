  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "Czerwony: Wznoszenie\nBia\u0142y: Utrzymuj wysoko\u015B\u0107\nNiebieski:
      Opadanie\n(temperatura docelowa/aktualna)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "Utrzymuj bezpieczny zakres wysoko\u015Bci\n(Staraj si\u0119 utrzymywa\u0107
      kontrolki na zielono)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Upewnij si\u0119, \u017Ce potrafisz kontrolowa\u0107 wysoko\u015B\u0107
      przed wylotem.\r\nCzerwone kontrolki i alarm sygnalizuj\u0105 niebezpiecze\u0144stwo
      w trakcie lotu.\r\nPami\u0119taj, \u017Ce masz map\u0119 (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "U\u017Cyj klucza do naprawiania (lub uderzania)"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "Ma\u0142o paliwa? Przytrzymaj tutaj :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: "Le\u0107 na P\xF3\u0142noc"
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: "Le\u0107 na Wsch\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: "Le\u0107 na Po\u0142udnie"
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: "Le\u0107 na Zach\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Dotrzyj do stacji drena\u017Cowych i wy\u0142\u0105cz je.\r\n\r\nW
      razie potrzeby dotrzyj do stacji tankowania."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "Stacja uko\u0144czona <sprite=\"blooderE2_32\" index=0>\r\nPozosta\u0142o:
      {left} x <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items:
      - rid: 6789982753568850024
  - m_Id: 3392004443594752
    m_Localized: "Wyl\u0105duj, aby zatankowa\u0107 <sprite=\"fuel2_32\" index=0>"
    m_Metadata:
      m_Items: []
  - m_Id: 6900102881861632
    m_Localized: "Wyl\u0105duj i wy\u0142\u0105cz stacj\u0119 <sprite=\"blooderF2_32\"
      index=0>"
    m_Metadata:
      m_Items: []
