    - rid: 6789982753568850030
  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "K\u0131rm\u0131z\u0131: Y\xFCksel\nBeyaz: \u0130rtifay\u0131 koru\nMavi:
      Al\xE7al\n(hedef/ger\xE7ek s\u0131cakl\u0131k)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "G\xFCvenli irtifa aral\u0131\u011F\u0131n\u0131 koru\n(G\xF6sterge
      \u0131\u015F\u0131klar\u0131n\u0131 ye\u015Fil tutmaya \xE7al\u0131\u015F)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Kalk\u0131\u015F yapmadan \xF6nce irtifay\u0131 nas\u0131l y\xF6netece\u011Finizi
      bildi\u011Finizden emin olun.\r\nU\xE7u\u015F s\u0131ras\u0131ndaki k\u0131rm\u0131z\u0131
      \u0131\u015F\u0131klar ve alarm tehlikeyi g\xF6sterir.\r\nBir haritan\u0131z
      oldu\u011Funu unutmay\u0131n (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "\u0130ngiliz anahtar\u0131n\u0131 tamir etmek (veya vurmak) i\xE7in
      kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "Yak\u0131t az m\u0131? Burada bas\u0131l\u0131 tut :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: "Kuzeye U\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: "Do\u011Fuya U\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: "G\xFCneye U\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: "Bat\u0131ya U\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Ana hedefiniz.\r\n\r\nYak\u0131t istasyonu."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "Vana kapat\u0131ld\u0131 <sprite=\"blooderE2_32\" index=0>\r\nKalan:
      {left} x <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items:
      - rid: 6789982753568850030
  - m_Id: 3392004443594752
    m_Localized: "Yak\u0131t ikmali i\xE7in ini\u015F yap\u0131n <sprite=\"fuel2_32\"
      index=0>"
    m_Metadata:
      m_Items: []
  - m_Id: 6900102881861632
    m_Localized: "\u0130ni\u015F yap ve <sprite=\"blooderF2_32\" index=0> istasyonunu
      kapat"
    m_Metadata:
      m_Items: []
