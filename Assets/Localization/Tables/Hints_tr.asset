  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "K\u0131rm\u0131z\u0131: Y\xFCksel\nBeyaz: \u0130rtifay\u0131 koru\nMavi:
      Al\xE7al\n(hedef/ger\xE7ek s\u0131cakl\u0131k)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "G\xFCvenli irtifa aral\u0131\u011F\u0131n\u0131 koru\n(G\xF6sterge
      \u0131\u015F\u0131klar\u0131n\u0131 ye\u015Fil tutmaya \xE7al\u0131\u015F)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "G\xFCneye gitmek i\xE7in bas\n(Y\xF6nler i\xE7in haritana bak)"
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "\u0130ngiliz anahtar\u0131n\u0131 tamir etmek (veya vurmak) i\xE7in
      kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "Yak\u0131t az m\u0131? Burada bas\u0131l\u0131 tut :)"
    m_Metadata:
      m_Items: []
