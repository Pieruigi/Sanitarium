  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "Rouge : Monter\nBlanc : Maintenir l'altitude\nBleu : Descendre\n(temp\xE9rature
      cible/r\xE9elle)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "Maintenez la plage d'altitude s\xE9curis\xE9e\n(Essayez de garder
      les voyants au vert)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Assurez-vous de savoir g\xE9rer l'altitude avant de partir.\r\nLes
      voyants rouges et l'alarme indiquent un danger en vol.\r\nRappelez-vous que
      vous avez une carte (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "Utilisez la cl\xE9 \xE0 molette pour r\xE9parer (ou frapper)"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: Peu de carburant ? Maintenez ici :)
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: Voler vers le Nord
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: Voler vers l'Est
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: Voler vers le Sud
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: Voler vers l'Ouest
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Atteignez les stations de drainage et \xE9teignez-les.\r\n\r\nAtteignez
      les stations de ravitaillement si n\xE9cessaire."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "Station termin\xE9e <sprite=\"blooderE2_32\" index=0>\r\nRestantes
      : {left} x <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items:
      - rid: 6789982753568850019
  - m_Id: 3392004443594752
    m_Localized: Atterrissez pour faire le plein <sprite="fuel2_32" index=0>
    m_Metadata:
      m_Items: []
  - m_Id: 6900102881861632
    m_Localized: "Aterrissez et \xE9teignez la station <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items: []
