    m_Localized: "\u5B87\u5B99\u898F\u6A21\u306E\u5927\u5929\u707D\u304C\u5730\u7403\u3092\u8972\u3044\u3001\u4E0D\u6C17\u5473\u3067\u4F4F\u3080\u3053\u3068\u306E\u3067\u304D\u306A\u3044\u8352\u91CE\u3078\u3068\u5909\u8C8C\u3055\u305B\u305F\u3002\u6DF7\u6C8C\u3068\u3057\u305F\u7A7A\u306B\u306F\u72C2\u3063\u305F\u3088\u3046\u306A\u5F37\u98A8\u304C\u5439\u304D\u8352\u308C\u3001\u6D77\u6D0B\u306F\u6FC3\u5BC6\u306A\u6DF1\u7D05\u306E\u7269\u8CEA\u3078\u3068\u59FF\u3092\u5909\u3048\u305F\u3002\r\n\n\u3053\u306E\u707D\u5384\u306E\u771F\u76F8\u3092\u89E3\u660E\u3059\u3079\u304F\u3001\u6C7A\u6B7B\u306E\u79D1\u5B66\u8ABF\u67FB\u968A\u304C\u305D\u306E\u767A\u751F\u6E90\u3067\u3042\u308B\u76C6\u5730\u3092\u7279\u5B9A\u3002\u6DB2\u4F53\u3092\u6C72\u307F\u51FA\u3057\u3001\u6D77\u5E95\u306B\u96A0\u3055\u308C\u305F\u79D8\u5BC6\u3092\u66B4\u304F\u305F\u3081\u306B\u6392\u6C34\u30B9\u30C6\u30FC\u30B7\u30E7\u30F3\u3092\u5EFA\u8A2D\u3057\u305F\u3002\r\n\n\u3057\u304B\u3057\u3001\u4EBA\u985E\u306E\u4ECB\u5165\u306F\u3001\u6C38\u9060\u306B\u7720\u3089\u305B\u3066\u304A\u304F\u3079\u304D\u300C\u4F55\u304B\u300D\u3092\u76EE\u899A\u3081\u3055\u305B\u3001\u72B6\u6CC1\u306F\u4E00\u6C17\u306B\u7834\u6EC5\u3078\u3068\u5411\u304B\u3046\u3002\u6B8B\u3055\u308C\u305F\u552F\u4E00\u306E\u5E0C\u671B\u306F\u3001\u8352\u6DBC\u3068\u3057\u305F\u5CE1\u8C37\u3078\u3068\u8DB3\u3092\u8E0F\u307F\u5165\u308C\u3001\u6050\u6016\u304C\u6C7A\u5B9A\u7684\u306A\u3082\u306E\u306B\u306A\u308B\u524D\u306B\u3059\u3079\u3066\u306E\u6392\u6C34\u30B9\u30C6\u30FC\u30B7\u30E7\u30F3\u3092\u505C\u6B62\u3055\u305B\u308B\u3053\u3068\u3060\u3002\n\n\u305D\u306E\u305F\u3081\u306B\u306F\u3001\u53E4\u3044\u30B5\u30FC\u30D3\u30B9\u7528\u71B1\u6C17\u7403\u306B\u4E57\u3063\u3066\u98DB\u884C\u3057\u306A\u3051\u308C\u3070\u306A\u3089\u306A\u3044\u2026\u305D\u308C\u304C\u541B\u306E\u4EFB\u52D9\u3060\u3002\n\n\u5E78\u904B\u3092\u7948\u308B\u3002"
