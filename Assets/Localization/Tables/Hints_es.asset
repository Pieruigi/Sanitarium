  m_TableData:
  - m_Id: 2168747712512
    m_Localized: 'Rojo: Ascender

      Blanco: Mantener altitud

      Azul: Descender

      (temperatura
      objetivo/real)'
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "Mant\xE9n el rango de altitud segura\n(Intenta mantener las luces
      indicadoras en verde)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Aseg\xFArate de saber gestionar la altitud antes de despegar.\r\nLas
      luces rojas y la alarma indican peligro durante el vuelo.\r\nRecuerda que tienes
      un mapa (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: Usa la llave inglesa para reparar (o golpear)
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "\xBFPoco combustible? Mant\xE9n pulsado aqu\xED :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: Volar hacia el Norte
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: Volar hacia el Este
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: Volar hacia el Sur
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: Volar hacia el Oeste
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Llega a las estaciones de drenaje y ap\xE1galas.\r\n\r\nLlega a
      las estaciones de repostaje si es necesario."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "V\xE1lvula cerrada <sprite=\"blooderE2_32\" index=0>\r\nRestantes:
      {left} x <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items:
      - rid: 6789982753568850029
  - m_Id: 3392004443594752
    m_Localized: Aterriza para repostar <sprite="fuel2_32" index=0>
    m_Metadata:
      m_Items: []
