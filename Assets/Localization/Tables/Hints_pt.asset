  m_TableData:
  - m_Id: 2168747712512
    m_Localized: 'Vermelho: Subir

      Branco: Manter altitude

      Azul: Descer

      (temperatura
      pretendida/atual)'
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: 'Mantenha o intervalo de altitude segura

      (Tente manter as
      luzes indicadoras verdes)'
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: 'Certifica-te de que sabes gerir a altitude antes de descolar.

      Luzes
      vermelhas e alarme indicam perigo durante o voo.

      Lembrar-te de que tens
      um mapa (E).'
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: Use a chave inglesa para reparar (ou bater)
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "Pouco combust\xEDvel? Mantenha premido aqui :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: Voar para o Norte
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: Voar para o Este
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: Voar para o Sul
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: Voar para o Oeste
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Alcan\xE7a as esta\xE7\xF5es de drenagem e desliga-as.\r\n\r\nAlcan\xE7a
      as esta\xE7\xF5es de reabastecimento se necess\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: "Esta\xE7\xE3o conclu\xEDda <sprite=\"blooderE2_32\" index=0>\r\nRestantes:
      {left} x <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items:
      - rid: 6789982753568850026
  - m_Id: 3392004443594752
    m_Localized: Aterra para reabastecer <sprite="fuel2_32" index=0>
    m_Metadata:
      m_Items: []
  - m_Id: 6900102881861632
    m_Localized: "Aterra e desliga a esta\xE7\xE3o <sprite=\"blooderF2_32\" index=0>"
    m_Metadata:
      m_Items: []
