  m_TableData:
  - m_Id: 2168747712512
    m_Localized: 'Red: Ascend

      White: Maintain altitude

      Blue: Descend

      (target/actual
      temperature)'
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: 'Maintain the safe altitude range

      (Try to keep the indicator
      lights green)'
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: 'Make sure you know how to manage altitude before taking off.

      Red
      lights and alarms indicate danger while flying.

      Remember that you have
      a map (E).'
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: Use the wrench to fix (or hit)
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: Low on fuel? Hold here :)
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: Fly North
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: Fly East
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: Fly South
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: Fly West
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: 'Reach the drainage stations and shut them down.


      Reach the
      refueling stations if needed.'
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: 'Valve closed <sprite="blooderE2_32" index=0>

      Remaining:
      {left} x <sprite="blooderF2_32" index=0>'
    m_Metadata:
      m_Items:
      - rid: 6789982753568850017
