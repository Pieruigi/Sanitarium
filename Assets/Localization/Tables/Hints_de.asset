  m_TableData:
  - m_Id: 2168747712512
    m_Localized: "Rot: Steigen\nWei\xDF: Flugh\xF6he halten\nBlau: Sinken\n(Ziel-/Ist-Temperatur)"
    m_Metadata:
      m_Items: []
  - m_Id: 11726249517056
    m_Localized: "Halte den sicheren H\xF6henbereich ein\n(Versuche, die Kontrollleuchten
      gr\xFCn zu halten)"
    m_Metadata:
      m_Items: []
  - m_Id: 14965174951936
    m_Localized: "Stelle sicher, dass du wei\xDFt, wie man die Flugh\xF6he steuert,
      bevor du abfliegst.\r\nRote Lichter und ein Alarm weisen w\xE4hrend des Flugs
      auf Gefahr hin.\r\nDenk daran, dass du eine Karte hast (E)."
    m_Metadata:
      m_Items: []
  - m_Id: 16247801503744
    m_Localized: "Benutze den Schraubenschl\xFCssel zum Reparieren (oder Schlagen)"
    m_Metadata:
      m_Items: []
  - m_Id: 25995586297856
    m_Localized: "Wenig Treibstoff? Hier gedr\xFCckt halten :)"
    m_Metadata:
      m_Items: []
  - m_Id: 810618406821888
    m_Localized: Nach Norden fliegen
    m_Metadata:
      m_Items: []
  - m_Id: 812087965114368
    m_Localized: Nach Osten fliegen
    m_Metadata:
      m_Items: []
  - m_Id: 812162539839488
    m_Localized: "Nach S\xFCden fliegen"
    m_Metadata:
      m_Items: []
  - m_Id: 812188754239488
    m_Localized: Nach Westen fliegen
    m_Metadata:
      m_Items: []
  - m_Id: 828913306558464
    m_Localized: "Erreiche die Entw\xE4sserungsstationen und schalte sie aus.\r\n\r\nErreiche
      bei Bedarf die Tankstationen."
    m_Metadata:
      m_Items: []
  - m_Id: 3327964178538496
    m_Localized: 'Ventil geschlossen <sprite="blooderE2_32" index=0>

      Verbleibend:
      {left} x <sprite="blooderF2_32" index=0>'
    m_Metadata:
      m_Items:
      - rid: 6789982753568850020
  - m_Id: 3392004443594752
    m_Localized: Lande zum Auftanken <sprite="fuel2_32" index=0>
    m_Metadata:
      m_Items: []
