  m_TableData:
  - m_Id: 10316931072
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044E
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C \u043D\u0435\u0443\u0434\u0430\u0447\u0435\u0439.
      \u041D\u0430\u0443\u0447\u043D\u0430\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0430
      \u0434\u0440\u0435\u043D\u0430\u0436\u043D\u044B\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C...
      \u0438 \u044D\u0442\u043E \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441\u0430\u043C\u0430\u044F
      \u043F\u043B\u043E\u0445\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044C.\n\n\u0427\u0442\u043E-\u0442\u043E
      \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B\u043E\u0441\u044C \u0433\u043B\u0443\u0431\u043E\u043A\u043E
      \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439, \u0438 \u0435\u0433\u043E
      \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 \u043D\u0430\u0448\u0443
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443.\n\n\u041C\u044B \u0441\u0447\u0438\u0442\u0430\u0435\u043C,
      \u0447\u0442\u043E, \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0432 \u0441\u0442\u0430\u043D\u0446\u0438\u0438
      \u0438 \u0432\u043D\u043E\u0432\u044C \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0432
      \u0431\u0430\u0441\u0441\u0435\u0439\u043D \u0432\u043E\u0434\u043E\u0439,
      \u044D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u0435\u0435 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435,
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0441\u043D\u043E\u0432\u0430
      \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u0441\u044F \u0432 \u0437\u0430\u0431\u0432\u0435\u043D\u0438\u0435.\n\n\u0422\u044B
      \u043D\u0430\u0448\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u043D\u0430\u0434\u0435\u0436\u0434\u0430.\n\n\u0421\u0430\u0434\u0438\u0441\u044C
      \u0432 \u0442\u043E\u0442 \u0441\u0442\u0430\u0440\u044B\u0439 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0439 \u0448\u0430\u0440,
      \u0434\u043E\u0431\u0435\u0440\u0438\u0441\u044C \u0434\u043E \u0432\u0441\u0435\u0445
      \u0441\u0442\u0430\u043D\u0446\u0438\u0439 \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438
      \u0438\u0445.\n\n\u0412\u0441\u0435\u0433\u0434\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0435
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E \u0432\u044B\u0441\u043E\u0442\u0443...
      \u0441\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u044D\u0442\u0438\u043C\u0438
      \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u0430\u043C\u0438.\n\n\u0423\u0434\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
