  m_TableData:
  - m_Id: 10316931072
    m_Localized: "\u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u0430\u0442\u0430\u043A\u043B\u0438\u0437\u043C \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u043B
      \u0417\u0435\u043C\u043B\u044E, \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432
      \u0435\u0435 \u0432 \u043F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u0443\u044E
      \u0438 \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u043D\u0443\u044E \u0434\u043B\u044F
      \u0436\u0438\u0437\u043D\u0438 \u043F\u0443\u0441\u0442\u043E\u0448\u044C.
      \u041D\u0435\u0431\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E \u043C\u0440\u0430\u0447\u043D\u043E\u0439
      \u043F\u0435\u043B\u0435\u043D\u043E\u0439, \u0440\u0430\u0437\u0440\u044B\u0432\u0435\u043C\u043E\u0439
      \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u043C\u0438 \u0432\u0435\u0442\u0440\u0430\u043C\u0438,
      \u0430 \u043E\u043A\u0435\u0430\u043D\u044B \u0443\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043C\u0435\u0441\u0442\u043E \u0433\u0443\u0441\u0442\u043E\u0439 \u0431\u0430\u0433\u0440\u043E\u0432\u043E\u0439
      \u0441\u0443\u0431\u0441\u0442\u0430\u043D\u0446\u0438\u0438.\r\n\n\u0412 \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u043E\u0439
      \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u043F\u0440\u0438\u0440\u043E\u0434\u0435 \u044D\u0442\u043E\u0439
      \u0447\u0443\u043C\u044B \u043D\u0430\u0443\u0447\u043D\u0430\u044F \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044F
      \u0441\u043C\u043E\u0433\u043B\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0431\u0430\u0441\u0441\u0435\u0439\u043D\u0430.
      \u0411\u044B\u043B\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u044B
      \u0434\u0440\u0435\u043D\u0430\u0436\u043D\u044B\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0430\u0447\u0430\u0442\u044C
      \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C \u0438 \u043E\u0431\u043D\u0430\u0436\u0438\u0442\u044C
      \u0442\u0430\u0439\u043D\u044B \u043C\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u0434\u043D\u0430.\r\n\n\u041D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435
      \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u043B\u043E \u0442\u043E, \u0447\u0442\u043E
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E\u0433\u0440\u0435\u0431\u0435\u043D\u043D\u044B\u043C, \u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u044B\u0448\u043B\u0430 \u0438\u0437-\u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F.
      \u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043D\u0430\u0434\u0435\u0436\u0434\u0430
      \u2014 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0432\u0433\u043B\u0443\u0431\u044C
      \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0445 \u043A\u0430\u043D\u044C\u043E\u043D\u043E\u0432
      \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432\u0441\u0435
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u043F\u043E\u043A\u0430 \u044D\u0442\u043E\u0442
      \u043A\u043E\u0448\u043C\u0430\u0440 \u043D\u0435 \u0441\u0442\u0430\u043B
      \u043D\u0435\u043E\u0431\u0440\u0430\u0442\u0438\u043C\u044B\u043C.\n\n\u0414\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u043B\u0435\u0442\u0435\u0442\u044C \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u043C
      \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u043C \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E\u043C
      \u0448\u0430\u0440\u0435... \u044D\u0442\u043E \u0432\u0430\u0448\u0430 \u043C\u0438\u0441\u0441\u0438\u044F.
      \n\n\u0423\u0434\u0430\u0447\u0438."
